# Export relevant vars in YOUR SHELL before `go get`; Go does NOT read `.env` by itself (`source .env`).
#
# For private modules only (comma-separated). Same list as `go env GOPRIVATE` below.
# Typical for this org + your account + lmk-website:
#   go env -w GOPRIVATE=github.com/go-web-services/*,github.com/Lomank123/*,github.com/lmk-website/*
export GITHUB_TOKEN=

APP_PORT=8020
APP_ENV=local

# Postgres
# POSTGRES_HOST=go-service-event-db
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5437
POSTGRES_DB=go-service-event-db
POSTGRES_USER=go-service-event
POSTGRES_PASSWORD=go-service-event-password
POSTGRES_SSL_MODE=disable

# Goose Migrations
GOOSE_MIGRATION_DIR=/app/migrations
GOOSE_TABLE=goose_migrations
